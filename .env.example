# =============================================================
#  Ask My Docs — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  .env is gitignored — never commit real secrets.
# =============================================================

# ── LLM (OpenAI) ─────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=                           # <-- paste your OpenAI key here
LLM_MODEL=gpt-4o-mini

# ── Web Search (Tavily) ───────────────────────────────────────
# Get your free key at: https://app.tavily.com
TAVILY_API_KEY=                           # <-- paste your Tavily key here

# ── Orchestrator ──────────────────────────────────────────────
AGENT_MAX_ROUNDS=4                        # max tool-calling rounds per query
WEB_SEARCH_SCORE_THRESHOLD=0.30          # below this reranker score → call web_search
SESSION_MEMORY_DB=./data/memory.db       # SQLite path for session memory

# ── Embeddings & Reranking (downloaded automatically) ────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# ── Vector Store ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Chunking ─────────────────────────────────────────────────
DEFAULT_CHUNKING=semantic                 # fixed | semantic | sentence_window
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SEMANTIC_SIMILARITY_THRESHOLD=0.75

# ── Retrieval ────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RRF_K=60

# ── Hallucination Detection ──────────────────────────────────
HALLUCINATION_THRESHOLD=0.7

# ── Evaluation / CI ──────────────────────────────────────────
EVAL_REGRESSION_THRESHOLD=0.02
EVAL_RESULTS_DIR=./evaluation/results
GOLDEN_QA_PATH=./evaluation/golden_qa.json
BASELINE_PATH=./evaluation/baselines/baseline.json

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
